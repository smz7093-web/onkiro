rules_version = '2';

// task.md 2.4 뼈대: 권한 확인 함수 + 회원 문서·동의 기록·변경 이력 규칙.
// 진단·상담·단가 등 데이터별 규칙은 해당 화면을 만들 때 아래 함수로 추가한다 (task.md Phase 5~9).
// 권한은 로그인 토큰의 커스텀 클레임에서 읽는다 (functions/src/permissions.ts, syncUserClaims).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 클레임이 없으면 일반 회원
    function role() {
      return signedIn() ? request.auth.token.get('role', 'member') : 'anonymous';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isStaff() {
      return role() in ['staff', 'admin'];
    }

    // prd.md 4절 권한표의 예/아니오 권한 (canEditPrices 등)
    function hasPerm(flag) {
      return isAdmin() || (role() == 'staff' && flag in request.auth.token.get('perms', []));
    }

    // all이면 전체, assigned면 담당자 본인 건만
    function levelAllows(level, assigneeUid) {
      return level == 'all' || (level == 'assigned' && assigneeUid == request.auth.uid);
    }

    // 진단 사진 접근 (photoAccess). assigneeUid는 assessments.assigneeUid
    function canSeePhotos(assigneeUid) {
      return isAdmin()
        || (role() == 'staff' && levelAllows(request.auth.token.get('photoAccess', 'none'), assigneeUid));
    }

    // 상담 접근 (consultAccess). assigneeUid는 consultations.assigneeUid
    function canHandleConsult(assigneeUid) {
      return isAdmin()
        || (role() == 'staff' && levelAllows(request.auth.token.get('consultAccess', 'none'), assigneeUid));
    }

    // 회원 문서: 본인은 role이 member인 문서만 만들 수 있다. 권한 필드는 관리자 함수만 쓴다.
    // 관리자는 회원·권한 관리 화면(ADM-05)을 위해 모든 회원 문서를 읽는다.
    match /users/{uid} {
      // 운영팀은 담당자 배정용으로 운영팀 계정 목록을 읽는다 (query는 role in ['staff', 'admin']로 걸러야 한다)
      allow read: if isSelf(uid) || isAdmin()
        || (isStaff() && resource.data.role in ['staff', 'admin']);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'role', 'createdAt'])
        && request.resource.data.role == 'member'
        && (request.resource.data.name == null || request.resource.data.name is string)
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone'])
        && (request.resource.data.name == null || request.resource.data.name is string)
        && (!('phone' in request.resource.data) || request.resource.data.phone is string);
      allow delete: if false;

      // 동의 기록: 추가만 한다 (prd.md COM-04, 6.7 약관 개정).
      match /consents/{consentId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['type', 'version', 'agreed', 'agreedAt'])
          && request.resource.data.type in ['terms', 'privacy', 'estimateDisclaimer', 'photoReview', 'photoModel']
          && request.resource.data.version is string
          && request.resource.data.agreed is bool
          && request.resource.data.agreedAt == request.time;
        allow update, delete: if false;
      }
    }

    // 단가 DB·가정값 버전 (ADM-01·02, task.md 5.3).
    // 초안(draft)만 편집 권한자가 만들고 고친다. status는 activateVersion 함수만 바꾼다.
    // 적용(active)·이전(retired) 버전은 아무도 고치지 못한다. 회원은 적용 버전만 읽는다(시뮬레이터 계산용).
    function versionDocValid(version, editorUid) {
      return request.resource.data.status == 'draft'
        && request.resource.data.data is map
        && request.resource.data.data.version == version
        && request.resource.data.updatedBy == editorUid
        && request.resource.data.updatedAt == request.time;
    }

    function versionCreateKeys() {
      return ['status', 'data', 'note', 'basedOn', 'createdBy', 'createdByName', 'createdAt',
              'updatedBy', 'updatedByName', 'updatedAt'];
    }

    match /priceVersions/{version} {
      allow read: if isStaff() || (signedIn() && resource.data.status == 'active');
      allow create: if hasPerm('canEditPrices')
        && request.resource.data.keys().hasOnly(versionCreateKeys())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && versionDocValid(version, request.auth.uid);
      allow update: if hasPerm('canEditPrices')
        && resource.data.status == 'draft'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['data', 'note', 'updatedBy', 'updatedByName', 'updatedAt'])
        && versionDocValid(version, request.auth.uid);
      allow delete: if hasPerm('canEditPrices') && resource.data.status == 'draft';
    }

    match /assumptionVersions/{version} {
      allow read: if isStaff() || (signedIn() && resource.data.status == 'active');
      allow create: if hasPerm('canEditAssumptions')
        && request.resource.data.keys().hasOnly(versionCreateKeys())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && versionDocValid(version, request.auth.uid);
      allow update: if hasPerm('canEditAssumptions')
        && resource.data.status == 'draft'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['data', 'note', 'updatedBy', 'updatedByName', 'updatedAt'])
        && versionDocValid(version, request.auth.uid);
      allow delete: if hasPerm('canEditAssumptions') && resource.data.status == 'draft';
    }

    // 진단·빈집 (task.md 6.1~6.5). 회원 본인 것만 읽고 쓴다. 관리자는 읽기만.
    // status·uid·담당자는 회원이 바꾸지 못한다 (견적 도달·상담 연결 시 Phase 7·9에서 규칙을 넓힌다).
    function diagnosisSteps() {
      return ['address', 'confirm', 'photos', 'checklist', 'estimate', 'revenue'];
    }

    function assessmentDoc(aid) {
      return get(/databases/$(database)/documents/assessments/$(aid)).data;
    }

    function ownsAssessment(aid) {
      return signedIn() && assessmentDoc(aid).uid == request.auth.uid;
    }

    // 진단에 연결하는 빈집은 본인 것이어야 한다 (같은 배치에서 만드는 경우 포함)
    function ownsPropertyAfter(propertyId) {
      return propertyId == null
        || getAfter(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid == request.auth.uid;
    }

    // 회원은 견적 도달 시 draft → saved/expertRequired로만 바꾼다. 상담 연결(consult)은 상담 신청이 바꾼다(9.1)
    function statusChangeAllowed() {
      return request.resource.data.get('status', 'draft') == resource.data.get('status', 'draft')
        || (resource.data.get('status', 'draft') != 'consult'
          && request.resource.data.status in ['saved', 'expertRequired'])
        || (request.resource.data.status == 'consult' && consultLinkValid());
    }

    // 상담을 신청하며 진단을 consult로 바꿀 때: 같은 배치에서 만든 본인 상담이 이 진단을 가리켜야 한다
    function consultLinkValid() {
      let c = getAfter(/databases/$(database)/documents/consultations/$(request.resource.data.lastConsultId)).data;
      return c.uid == request.auth.uid && c.assessmentId == request.resource.id;
    }

    // 마지막 스냅샷을 바꿀 때는 같은 배치에서 만든 본인 스냅샷이어야 한다
    function snapshotLinkValid(aid) {
      return request.resource.data.get('latestSnapshotId', null) == resource.data.get('latestSnapshotId', null)
        || getAfter(/databases/$(database)/documents/assessments/$(aid)/snapshots/$(request.resource.data.latestSnapshotId))
             .data.createdBy == request.auth.uid;
    }

    match /assessments/{aid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()
        || canHandleConsult(resource.data.get('assigneeUid', null)));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'propertyId', 'address', 'status', 'reached',
                                                 'checklist', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.propertyId == null
        && request.resource.data.reached == 'address'
        && request.resource.data.checklist is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['propertyId', 'address', 'reached', 'checklist', 'updatedAt',
                       'estimateOptions', 'revenueInput', 'latestSnapshotId', 'latestInputsKey',
                       'latestSummary', 'status', 'lastConsultId'])
        && request.resource.data.reached in diagnosisSteps()
        && request.resource.data.checklist is map
        && (request.resource.data.address == null || request.resource.data.address is string)
        && ownsPropertyAfter(request.resource.data.propertyId)
        && statusChangeAllowed()
        && snapshotLinkValid(aid)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // 계산 스냅샷 (SIM-20, task.md 7.4): 추가만 하고 고치거나 지우지 않는다
      match /snapshots/{sid} {
        allow read: if ownsAssessment(aid) || isAdmin()
          || canHandleConsult(assessmentDoc(aid).get('assigneeUid', null));
        allow create: if ownsAssessment(aid)
          && request.resource.data.keys().hasOnly(['inputs', 'options', 'result', 'priceVersion',
                                                   'assumptionVersion', 'formulaVersion', 'inputsKey',
                                                   'reason', 'parentSnapshotId', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.parentSnapshotId == null
          && request.resource.data.reason in ['view', 'save', 'pdf', 'consult']
          && request.resource.data.priceVersion is string
          && request.resource.data.assumptionVersion is string
          && request.resource.data.formulaVersion is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // 사진 기록. 파일은 Storage users/{uid}/assessments/{aid}/photos/{photoId}.jpg (storage.rules)
      match /photos/{photoId} {
        allow read: if ownsAssessment(aid)
          || canSeePhotos(assessmentDoc(aid).get('assigneeUid', null));
        allow create: if ownsAssessment(aid)
          && request.resource.data.keys().hasOnly(['part', 'storagePath', 'exifStripped', 'consentModelUse',
                                                   'deleteAfter', 'width', 'height', 'size', 'createdAt'])
          && request.resource.data.part in ['front', 'back', 'left', 'right', 'roof', 'kitchen', 'bathroom', 'crack']
          && request.resource.data.storagePath == 'users/' + request.auth.uid + '/assessments/' + aid + '/photos/' + photoId + '.jpg'
          && request.resource.data.exifStripped == true
          && request.resource.data.consentModelUse is bool
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if ownsAssessment(aid);
      }
    }

    // 상담 (CON-01·02, task.md 9.1·9.2). 회원은 본인 상담을 만들고 읽는다.
    // 상태·담당자·메모 변경과 전화 대리 입력은 서버 함수(updateConsultation, createProxyConsultation)만 한다.
    match /consultations/{cid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid
        || canHandleConsult(resource.data.get('assigneeUid', null)));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'type', 'assessmentId', 'snapshotId', 'applicantName',
                                                 'phone', 'ownership', 'preferredDate', 'memo', 'phoneRequested',
                                                 'status', 'assigneeUid', 'assigneeName', 'proxyEnteredBy',
                                                 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['inspection', 'turnkey', 'entrust']
        && request.resource.data.ownership in ['self', 'family', 'coHeir', 'other']
        && request.resource.data.applicantName is string && request.resource.data.applicantName.size() > 0
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 2000
        && request.resource.data.phoneRequested is bool
        && (request.resource.data.preferredDate == null || request.resource.data.preferredDate is string)
        && request.resource.data.status == 'received'
        && request.resource.data.assigneeUid == null
        && request.resource.data.assigneeName == null
        && request.resource.data.proxyEnteredBy == null
        && (request.resource.data.assessmentId == null
          || get(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)).data.uid == request.auth.uid)
        && (request.resource.data.snapshotId == null || request.resource.data.snapshotId is string)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;

      match /events/{eid} {
        allow read: if canHandleConsult(get(/databases/$(database)/documents/consultations/$(cid)).data.get('assigneeUid', null));
        allow write: if false;
      }
    }

    match /properties/{pid} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'addressRoad', 'addressJibun', 'pnu', 'lat', 'lng',
                                                 'noRegistry', 'facts', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.addressRoad is string
        && request.resource.data.noRegistry is bool
        && request.resource.data.facts is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['addressRoad', 'addressJibun', 'pnu', 'lat', 'lng', 'noRegistry', 'facts', 'updatedAt',
                       'nearby', 'lookedUpFor'])
        && request.resource.data.addressRoad is string
        && request.resource.data.noRegistry is bool
        && request.resource.data.facts is map
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 지점(숙소) 상세 (STY-01·02, task.md 9.3): 누구나 읽는다. 실적·공사비 하위 컬렉션은 아래 기본 거부에 걸린다.
    match /branches/{branchId} {
      allow read: if true;
      // 콘텐츠 편집 권한자가 만들고 고친다 (관리 화면 /admin/branches). 삭제는 하지 않는다
      allow create, update: if hasPerm('canEditContent')
        && branchId.matches('^[a-z0-9][a-z0-9-]{1,39}$')
        && request.resource.data.keys().hasOnly(['name', 'content', 'airbnbUrl', 'naverUrl',
                                                 'updatedBy', 'updatedByName', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.content is map
        && (request.resource.data.airbnbUrl == null || request.resource.data.airbnbUrl is string)
        && (request.resource.data.naverUrl == null || request.resource.data.naverUrl is string)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 변경 이력: 서버 함수만 쓰고 관리자만 읽는다.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
