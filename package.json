{
  "name": "onkiro",
  "private": true,
  "scripts": {
    "emulators": "firebase emulators:start --project demo-onkiro",
    "firebase": "firebase",
    "test:rules": "firebase emulators:exec --only firestore --project demo-onkiro \"vitest run\"",
    "emulators:app": "firebase emulators:start --only auth,firestore,storage --project demo-onkiro",
    "seed:emulator": "vitest run --config seed/vitest.seed.config.mts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1",
    "vitest": "^5.0.3"
  }
}
