rules_version = '2';

// task.md 2.4 뼈대: 권한 확인 함수만 두고 모든 경로를 막는다.
// 진단 사진 (task.md 6.4): 진단 주인만 올리고 지운다. 운영팀은 photoAccess 권한대로 읽는다.
// 진단 주인·담당자는 Firestore assessments 문서에서 읽는다 (교차 서비스 규칙).
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', 'member') : 'anonymous';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // 진단 사진 접근 (photoAccess). assigneeUid는 Firestore assessments.assigneeUid에서 읽어 넘긴다.
    function canSeePhotos(assigneeUid) {
      return isAdmin()
        || (role() == 'staff'
          && (request.auth.token.get('photoAccess', 'none') == 'all'
            || (request.auth.token.get('photoAccess', 'none') == 'assigned' && assigneeUid == request.auth.uid)));
    }

    function assessment(aid) {
      return firestore.get(/databases/(default)/documents/assessments/$(aid)).data;
    }

    function ownsAssessment(aid) {
      return signedIn() && assessment(aid).uid == request.auth.uid;
    }

    // 브라우저에서 줄이고 위치정보(EXIF)를 지운 JPEG만 받는다 (lib/diagnosis/photo-file.ts)
    match /assessments/{aid}/photos/{fileName} {
      allow read: if ownsAssessment(aid) || canSeePhotos(assessment(aid).get('assigneeUid', null));
      allow create: if ownsAssessment(aid)
        && fileName.matches('[A-Za-z0-9]+[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;
      allow update: if false;
      allow delete: if ownsAssessment(aid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
